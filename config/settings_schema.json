[
  {
    "name": "theme_info",
    "theme_name": "Vetra Fashion",
    "theme_version": "0.1.0",
    "theme_author": "SrLuizGuimaraes",
    "theme_documentation_url": "https://github.com/SrLuizGuimaraes/Vetra-Fashion",
    "theme_support_url": "https://github.com/SrLuizGuimaraes/Vetra-Fashion/issues"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "montserrat_n3",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "montserrat_n4",
        "label": "t:general.secondary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#1C1C1C",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#67101A",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "secondary_background_color",
        "default": "#F5F1EC",
        "label": "t:labels.secondary_background"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E7E0D8",
        "label": "t:labels.border"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 2
      }
    ]
  }
]
