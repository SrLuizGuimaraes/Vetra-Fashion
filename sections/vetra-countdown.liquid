{% comment %}
  A live countdown to a merchant-set date/time, for sale campaigns and
  product launches.
{% endcomment %}

<div class="countdown shopify-section">
  <div class="countdown__inner" data-countdown data-end="{{ section.settings.end_date }}">
    {% if section.settings.heading != blank %}
      <p class="countdown__heading">{{ section.settings.heading }}</p>
    {% endif %}

    <div class="countdown__timer" data-countdown-timer>
      <div class="countdown__unit">
        <span data-countdown-days>00</span>
        <label>{{ 'countdown.days' | t }}</label>
      </div>
      <div class="countdown__unit">
        <span data-countdown-hours>00</span>
        <label>{{ 'countdown.hours' | t }}</label>
      </div>
      <div class="countdown__unit">
        <span data-countdown-minutes>00</span>
        <label>{{ 'countdown.minutes' | t }}</label>
      </div>
      <div class="countdown__unit">
        <span data-countdown-seconds>00</span>
        <label>{{ 'countdown.seconds' | t }}</label>
      </div>
    </div>

    <p class="countdown__ended" data-countdown-ended hidden>{{ section.settings.ended_text }}</p>

    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="countdown__cta">{{ section.settings.link_text }}</a>
    {% endif %}
  </div>
</div>

<script src="{{ 'vetra-countdown.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .countdown {
    padding: 3rem 0;
    text-align: center;
  }

  .countdown__heading {
    margin: 0 0 1.5rem;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.5rem;
  }

  .countdown__timer {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.5rem;
  }

  .countdown__unit span {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 2rem;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .countdown__unit label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  .countdown__ended {
    font-size: 1.125rem;
  }

  .countdown__cta {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.75rem 2rem;
    background-color: var(--color-accent);
    color: var(--color-background);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.countdown",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Sale ends in"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "t:labels.end_date",
      "info": "t:labels.end_date_info",
      "default": "2026-12-31T23:59:59"
    },
    {
      "type": "text",
      "id": "ended_text",
      "label": "t:labels.ended_text",
      "default": "This offer has ended"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:labels.link_text",
      "default": "Shop now"
    }
  ],
  "presets": [
    {
      "name": "t:general.countdown"
    }
  ]
}
{% endschema %}
