{% comment %}
  A draggable before/after image comparison slider, useful for
  fit/fabric close-ups or styling transformations.
{% endcomment %}

<div class="before-after shopify-section" data-reveal>
  {% if section.settings.heading != blank %}
    <h2 class="before-after__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="before-after__frame" data-before-after>
    {% if section.settings.before_image %}
      {{
        section.settings.before_image
        | image_url: width: 1400
        | image_tag: class: 'before-after__image before-after__image--before', loading: 'lazy'
      }}
    {% endif %}

    <div class="before-after__after-wrap" data-before-after-clip>
      {% if section.settings.after_image %}
        {{
          section.settings.after_image
          | image_url: width: 1400
          | image_tag: class: 'before-after__image before-after__image--after', loading: 'lazy'
        }}
      {% endif %}
    </div>

    <div class="before-after__handle" data-before-after-handle>
      <span class="before-after__handle-grip"></span>
    </div>

    <input
      type="range"
      class="before-after__range"
      min="0"
      max="100"
      value="50"
      data-before-after-range
      aria-label="{{ 'lookbook.before_after_slider' | t }}"
    >

    <span class="before-after__label before-after__label--before">{{ section.settings.before_label }}</span>
    <span class="before-after__label before-after__label--after">{{ section.settings.after_label }}</span>
  </div>
</div>

<script src="{{ 'vetra-before-after.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .before-after {
    padding: 3rem 0;
  }

  .before-after__heading {
    margin: 0 0 1.5rem;
    text-align: center;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.75rem;
  }

  .before-after__frame {
    position: relative;
    overflow: hidden;
    user-select: none;
  }

  .before-after__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .before-after__after-wrap {
    position: absolute;
    inset: 0;
    clip-path: inset(0 50% 0 0);
  }

  .before-after__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background-color: var(--color-background);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .before-after__handle-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--color-background);
    transform: translate(-50%, -50%);
    box-shadow: 0 0.25rem 0.75rem rgb(0 0 0 / 20%);
  }

  .before-after__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
  }

  .before-after__label {
    position: absolute;
    top: 1rem;
    padding: 0.375rem 0.75rem;
    background-color: rgb(0 0 0 / 55%);
    color: #fff;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    pointer-events: none;
  }

  .before-after__label--before {
    left: 1rem;
  }

  .before-after__label--after {
    right: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.before_after",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "t:labels.before_image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "t:labels.after_image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "t:labels.before_label",
      "default": "Antes"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "t:labels.after_label",
      "default": "Depois"
    }
  ],
  "presets": [
    {
      "name": "t:general.before_after"
    }
  ]
}
{% endschema %}
