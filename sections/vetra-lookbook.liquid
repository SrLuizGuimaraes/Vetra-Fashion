{% comment %}
  A full-width editorial image with clickable hotspots that reveal a
  linked product's price and title — the "shop the look" pattern.
{% endcomment %}

<div class="lookbook shopify-section">
  <div class="lookbook__media" data-reveal>
    {% if section.settings.image %}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag: class: 'lookbook__image', loading: 'lazy', widths: '900,1200,1800'
      }}
    {% endif %}

    {% for block in section.blocks %}
      {% if block.settings.product %}
        <button
          type="button"
          class="lookbook__hotspot"
          style="left: {{ block.settings.position_x }}%; top: {{ block.settings.position_y }}%;"
          data-hotspot
          {{ block.shopify_attributes }}
        >
          <span class="lookbook__hotspot-dot"></span>
          <span class="visually-hidden">{{ block.settings.product.title }}</span>

          <span class="lookbook__hotspot-card">
            <a href="{{ block.settings.product.url }}">
              {{ block.settings.product.featured_image | image_url: width: 200 | image_tag: width: 100, height: 125 }}
              <span class="lookbook__hotspot-title">{{ block.settings.product.title }}</span>
              {% render 'product-price', product: block.settings.product %}
            </a>
          </span>
        </button>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script src="{{ 'vetra-lookbook.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .lookbook__media {
    position: relative;
  }

  .lookbook__image {
    width: 100%;
    height: auto;
  }

  .lookbook__hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .lookbook__hotspot-dot {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background-color: var(--color-background);
    border: 2px solid var(--color-accent);
    box-shadow: 0 0 0 0 rgb(122 31 43 / 45%);
    animation: lookbook-pulse 2.4s ease-out infinite;
  }

  @keyframes lookbook-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(122 31 43 / 45%);
    }
    70% {
      box-shadow: 0 0 0 0.75rem rgb(122 31 43 / 0%);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(122 31 43 / 0%);
    }
  }

  .lookbook__hotspot-card {
    position: absolute;
    bottom: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%);
    width: 12rem;
    padding: 0.75rem;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 12%);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
    z-index: 5;
  }

  .lookbook__hotspot:hover .lookbook__hotspot-card,
  .lookbook__hotspot:focus-within .lookbook__hotspot-card,
  .lookbook__hotspot.is-open .lookbook__hotspot-card {
    opacity: 1;
    visibility: visible;
  }

  .lookbook__hotspot-card a {
    display: block;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .lookbook__hotspot-title {
    display: block;
    margin: 0.5rem 0 0.25rem;
    font-size: 0.8125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.lookbook",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "t:general.hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:labels.product"
        },
        {
          "type": "range",
          "id": "position_x",
          "label": "t:labels.position_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "t:labels.position_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.lookbook",
      "blocks": [{ "type": "hotspot" }]
    }
  ]
}
{% endschema %}
