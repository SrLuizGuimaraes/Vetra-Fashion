{% comment %}
  Global cart drawer, rendered once via header-group.json so it has a
  stable section id ("cart-drawer") that the Ajax Cart API can
  re-render through the `sections` param on /cart/add.js,
  /cart/change.js, etc. See assets/cart.js.
{% endcomment %}

<vetra-dialog id="cart-drawer">
  <dialog class="cart-drawer">
    <div class="cart-drawer__header">
      <p class="cart-drawer__title">{{ 'cart.title' | t }} ({{ cart.item_count }})</p>
      <button type="button" class="cart-drawer__close" data-dialog-close>
        {{ 'icon-close.svg' | inline_asset_content }}
        <span class="visually-hidden">{{ 'general.close' | t }}</span>
      </button>
    </div>

    {% if cart.item_count > 0 %}
      <ul class="cart-drawer__items">
        {% for item in cart.items %}
          <li class="cart-drawer__item" data-cart-item>
            <a href="{{ item.url }}" class="cart-drawer__item-image">
              {{ item.image | image_url: width: 200, height: 250, crop: 'center' | image_tag: width: 100, height: 125 }}
            </a>

            <div class="cart-drawer__item-details">
              <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>
              {% unless item.variant.title == 'Default Title' %}
                <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
              {% endunless %}
              {% render 'product-price', variant: item.variant %}

              <div class="cart-drawer__item-qty">
                <button type="button" data-cart-qty-change="-1" data-line="{{ forloop.index }}" aria-label="-">−</button>
                <span data-cart-qty-value>{{ item.quantity }}</span>
                <button type="button" data-cart-qty-change="1" data-line="{{ forloop.index }}" aria-label="+">+</button>
              </div>
            </div>

            <button type="button" class="cart-drawer__item-remove" data-cart-qty-set="0" data-line="{{ forloop.index }}">
              {{ 'cart.remove' | t }}
            </button>
          </li>
        {% endfor %}
      </ul>

      <div class="cart-drawer__footer">
        <label class="cart-drawer__note">
          <span>{{ 'cart.note' | t }}</span>
          <textarea data-cart-note>{{ cart.note }}</textarea>
        </label>

        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>

        <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart">{{ 'cart.view_cart' | t }}</a>
        <a href="{{ routes.cart_url }}" class="cart-drawer__checkout" data-cart-checkout>{{ 'cart.checkout' | t }}</a>
      </div>
    {% else %}
      <div class="cart-drawer__empty">
        <p>{{ 'cart.empty' | t }}</p>
        <button type="button" data-dialog-close>{{ 'cart.continue_shopping' | t }}</button>
      </div>
    {% endif %}
  </dialog>
</vetra-dialog>

<script src="{{ 'cart-drawer.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .cart-drawer {
    width: 100%;
    max-width: 26rem;
    height: 100%;
    max-height: 100%;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .cart-drawer::backdrop {
    background-color: rgb(0 0 0 / 40%);
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-drawer__title {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
  }

  .cart-drawer__close {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground);
  }

  .cart-drawer__close svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .cart-drawer__items {
    list-style: none;
    margin: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    overflow-y: auto;
    flex: 1;
  }

  .cart-drawer__item {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    gap: 1rem;
  }

  .cart-drawer__item-image img {
    width: 5rem;
    height: auto;
  }

  .cart-drawer__item-title {
    display: block;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }

  .cart-drawer__item-variant {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .cart-drawer__item-qty {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    border: 1px solid var(--color-border);
    width: fit-content;
  }

  .cart-drawer__item-qty button {
    width: 1.75rem;
    height: 1.75rem;
    background: none;
    border: 0;
    cursor: pointer;
    font-size: 0.875rem;
  }

  .cart-drawer__item-remove {
    align-self: start;
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.75rem;
    text-decoration: underline;
    color: var(--color-foreground);
    opacity: 0.7;
    cursor: pointer;
  }

  .cart-drawer__footer {
    padding: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .cart-drawer__note {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .cart-drawer__note textarea {
    min-height: 4rem;
    padding: 0.625rem;
    border: 1px solid var(--color-border);
    font-family: inherit;
    text-transform: none;
    letter-spacing: normal;
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }

  .cart-drawer__view-cart,
  .cart-drawer__checkout {
    display: block;
    width: 100%;
    padding: 0.875rem;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8125rem;
  }

  .cart-drawer__view-cart {
    color: var(--color-foreground);
    border: 1px solid var(--color-border);
    margin-bottom: 0.75rem;
  }

  .cart-drawer__checkout {
    background-color: var(--color-accent);
    color: var(--color-background);
  }

  .cart-drawer__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .cart-drawer__empty button {
    padding: 0.75rem 1.5rem;
    background-color: var(--color-foreground);
    color: var(--color-background);
    border: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
    cursor: pointer;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
