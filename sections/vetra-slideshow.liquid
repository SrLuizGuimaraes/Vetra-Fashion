{% comment %}
  A full-width slideshow for the home page, built on native CSS
  scroll-snap (so swipe/trackpad scrolling works with zero JS) plus a
  small script for the dots and optional autoplay.
{% endcomment %}

<div class="slideshow shopify-section full-width" data-slideshow data-autoplay="{{ section.settings.autoplay_seconds }}">
  <div class="slideshow__track" data-slideshow-track>
    {% for block in section.blocks %}
      <div class="slideshow__slide" data-slideshow-slide {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          {{
            block.settings.image
            | image_url: width: 2000
            | image_tag: class: 'slideshow__image', loading: forloop.first | default: 'eager', widths: '750,1200,2000'
          }}
        {% endif %}

        <div class="slideshow__content">
          {% if block.settings.heading != blank %}
            <h2 class="slideshow__heading">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.subheading != blank %}
            <p class="slideshow__subheading">{{ block.settings.subheading }}</p>
          {% endif %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="slideshow__cta">{{ block.settings.link_text }}</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="slideshow__dots" data-slideshow-dots>
      {% for block in section.blocks %}
        <button
          type="button"
          class="slideshow__dot {% if forloop.first %}is-active{% endif %}"
          data-slideshow-dot="{{ forloop.index0 }}"
          aria-label="{{ 'slideshow.go_to_slide' | t: number: forloop.index }}"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script src="{{ 'vetra-slideshow.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .slideshow {
    position: relative;
  }

  .slideshow__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .slideshow__track::-webkit-scrollbar {
    display: none;
  }

  .slideshow__slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: flex;
    align-items: flex-end;
    min-height: 32rem;
    color: #fff;
  }

  .slideshow__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slideshow__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 3rem var(--page-margin) 4rem;
    background: linear-gradient(to top, rgb(0 0 0 / 50%), transparent);
  }

  .slideshow__heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .slideshow__subheading {
    max-width: 32rem;
    margin: 0 0 1.5rem;
    opacity: 0.9;
  }

  .slideshow__cta {
    display: inline-block;
    padding: 0.875rem 2rem;
    background-color: var(--color-accent);
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8125rem;
  }

  .slideshow__dots {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
  }

  .slideshow__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1px solid #fff;
    background: none;
    padding: 0;
    cursor: pointer;
  }

  .slideshow__dot.is-active {
    background-color: #fff;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.slideshow",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_seconds",
      "min": 0,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 0,
      "label": "t:labels.autoplay_seconds",
      "info": "t:labels.autoplay_seconds_info"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:labels.subheading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:labels.link_text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.slideshow",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
