{% comment %}
  Tabbed content (e.g. Description / Sizing / Shipping).
{% endcomment %}

<div class="tabs shopify-section" data-tabs>
  {% if section.settings.heading != blank %}
    <h2 class="tabs__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="tabs__group">
    <div class="tabs__list" role="tablist">
      {% for block in section.blocks %}
        <button
          type="button"
          class="tabs__tab {% if forloop.first %}is-active{% endif %}"
          role="tab"
          data-tabs-trigger="{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.title }}
        </button>
      {% endfor %}
    </div>

    <div class="tabs__panels">
      {% for block in section.blocks %}
        <div class="tabs__panel {% if forloop.first %}is-active{% endif %}" role="tabpanel" data-tabs-panel="{{ forloop.index }}">
          {{ block.settings.content }}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script src="{{ 'vetra-tabs.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .tabs {
    padding: 3rem 0;
  }

  .tabs__heading {
    margin: 0 0 1.5rem;
    text-align: center;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.75rem;
  }

  .tabs__list {
    display: flex;
    justify-content: center;
    gap: 2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .tabs__tab {
    padding: 0 0 0.75rem;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.8125rem;
    opacity: 0.6;
    color: var(--color-foreground);
  }

  .tabs__tab.is-active {
    opacity: 1;
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .tabs__panel {
    display: none;
    max-width: 42rem;
    margin: 0 auto;
    line-height: 1.6;
  }

  .tabs__panel.is-active {
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:general.tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:labels.content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.tabs",
      "blocks": [{ "type": "tab" }, { "type": "tab" }]
    }
  ]
}
{% endschema %}
