{% comment %}
  A curated row of products from a chosen collection, for the home
  page or landing pages.
{% endcomment %}

<div class="featured-collection shopify-section">
  <div class="featured-collection__header">
    {% if section.settings.heading != blank %}
      <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.collection != blank %}
      <a href="{{ section.settings.collection.url }}" class="featured-collection__view-all">
        {{ 'collection.view_all' | t }}
      </a>
    {% endif %}
  </div>

  <div class="featured-collection__grid">
    {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
      {% render 'product-card', product: product %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .featured-collection {
    padding: 3rem 0;
  }

  .featured-collection__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .featured-collection__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.75rem;
  }

  .featured-collection__view-all {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    text-decoration: none;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 2rem 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Destaques"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:labels.products_to_show"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}
