{% comment %}
  A dismissible promo popup that opens itself after a delay. Respects
  a "don't show again for N days" cooldown stored in localStorage.
{% endcomment %}

<vetra-dialog
  id="promo-popup"
  data-promo-popup
  data-delay="{{ section.settings.delay_seconds | default: 4 }}"
  data-frequency-days="{{ section.settings.frequency_days | default: 7 }}"
>
  <dialog class="promo-popup">
    <button type="button" class="promo-popup__close" data-dialog-close>
      {{ 'icon-close.svg' | inline_asset_content }}
      <span class="visually-hidden">{{ 'general.close' | t }}</span>
    </button>

    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 700 | image_tag: class: 'promo-popup__image' }}
    {% endif %}

    <div class="promo-popup__body">
      {% if section.settings.heading != blank %}
        <p class="promo-popup__heading">{{ section.settings.heading }}</p>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="promo-popup__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}" class="promo-popup__cta">{{ section.settings.link_text }}</a>
      {% endif %}
    </div>
  </dialog>
</vetra-dialog>

<script src="{{ 'vetra-promo-popup.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .promo-popup {
    width: min(32rem, 92vw);
    padding: 0;
    border: 0;
    overflow: hidden;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .promo-popup::backdrop {
    background-color: rgb(0 0 0 / 50%);
  }

  .promo-popup__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--color-background);
    mix-blend-mode: difference;
  }

  .promo-popup__close svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .promo-popup__image {
    width: 100%;
    height: 14rem;
    object-fit: cover;
  }

  .promo-popup__body {
    padding: 2rem;
    text-align: center;
  }

  .promo-popup__heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.375rem;
  }

  .promo-popup__text {
    opacity: 0.8;
    margin-bottom: 1.25rem;
  }

  .promo-popup__cta {
    display: inline-block;
    padding: 0.75rem 2rem;
    background-color: var(--color-accent);
    color: var(--color-background);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.promo_popup",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Entre para a lista"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:labels.link_text",
      "default": "Comprar agora"
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "t:labels.delay_seconds",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "range",
      "id": "frequency_days",
      "label": "t:labels.frequency_days",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "d",
      "default": 7
    }
  ],
  "presets": [
    {
      "name": "t:general.promo_popup"
    }
  ]
}
{% endschema %}
