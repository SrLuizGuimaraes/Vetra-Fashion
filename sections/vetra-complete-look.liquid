{% comment %}
  "Complete the look" cross-sell: a merchant-curated row of products
  that pair well with the one being viewed.
{% endcomment %}

<div class="complete-look shopify-section">
  {% if section.settings.heading != blank %}
    <h2 class="complete-look__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="complete-look__grid">
    {% for block in section.blocks %}
      {% if block.settings.product != blank %}
        {% render 'product-card', product: block.settings.product %}
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .complete-look {
    padding: 3rem 0;
  }

  .complete-look__heading {
    margin: 0 0 2rem;
    text-align: center;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.75rem;
  }

  .complete-look__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.complete_look",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Complete o look"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:general.product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:labels.product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.complete_look",
      "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
