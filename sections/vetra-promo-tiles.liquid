{% comment %}
  A responsive grid of image tiles, each linking to a collection or
  product, used for promo/merchandising banners on the home page.
{% endcomment %}

<div class="promo-tiles shopify-section">
  {% if section.settings.heading != blank %}
    <h2 class="promo-tiles__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="promo-tiles__grid">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="promo-tile"
        data-reveal
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image %}
          {{
            block.settings.image
            | image_url: width: 900
            | image_tag: class: 'promo-tile__image', loading: 'lazy', widths: '450,600,900'
          }}
        {% endif %}
        <div class="promo-tile__caption">
          {% if block.settings.heading != blank %}
            <p class="promo-tile__title">{{ block.settings.heading }}</p>
          {% endif %}
          {% if block.settings.link_text != blank %}
            <span class="promo-tile__cta">{{ block.settings.link_text }}</span>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .promo-tiles {
    padding: 3rem 0;
  }

  .promo-tiles__heading {
    margin: 0 0 2rem;
    text-align: center;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.75rem;
  }

  .promo-tiles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }

  .promo-tile {
    position: relative;
    display: block;
    overflow: hidden;
    color: var(--color-background);
    text-decoration: none;
  }

  .promo-tile__image {
    width: 100%;
    height: 24rem;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .promo-tile:hover .promo-tile__image {
    transform: scale(1.04);
  }

  .promo-tile__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgb(0 0 0 / 45%), transparent);
  }

  .promo-tile__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.375rem;
  }

  .promo-tile__cta {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.promo_tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:general.tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:labels.link_text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.promo_tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
