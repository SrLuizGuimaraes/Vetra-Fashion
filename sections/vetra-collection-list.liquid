{% comment %}
  A grid of collection cards (image + title), for browsing by
  category from the home page.
{% endcomment %}

<div class="collection-list shopify-section">
  {% if section.settings.heading != blank %}
    <h2 class="collection-list__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="collection-list__grid">
    {% for collection in section.settings.collections %}
      <a href="{{ collection.url }}" class="collection-card" data-reveal>
        {% if collection.featured_image %}
          {{
            collection.featured_image
            | image_url: width: 700
            | image_tag: class: 'collection-card__image', loading: 'lazy', widths: '350,500,700'
          }}
        {% endif %}
        <span class="collection-card__title">{{ collection.title }}</span>
      </a>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .collection-list {
    padding: 3rem 0;
  }

  .collection-list__heading {
    margin: 0 0 2rem;
    text-align: center;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.75rem;
  }

  .collection-list__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
  }

  .collection-card {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    color: var(--color-background);
  }

  .collection-card__image {
    width: 100%;
    height: 18rem;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .collection-card:hover .collection-card__image {
    transform: scale(1.04);
  }

  .collection-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 35%), transparent 60%);
  }

  .collection-card__title {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 1;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9375rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by category"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:labels.collections"
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_list"
    }
  ]
}
{% endschema %}
