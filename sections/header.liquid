<header class="site-header">
  <div class="site-header__nav">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url, class: 'site-header__nav-link' }}
    {% endfor %}
  </div>

  <h1 class="site-header__logo">
    {{ shop.name | link_to: routes.root_url }}
  </h1>

  <div class="site-header__icons">
    <a href="{{ routes.search_url }}" class="site-header__icon" aria-label="{{ 'search.title' | t }}">
      {{ 'icon-search.svg' | inline_asset_content }}
    </a>

    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}" class="site-header__icon">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}" class="site-header__icon site-header__icon--cart">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}
      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--page-margin);
    height: 6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__logo {
    justify-self: center;
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 1.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-header__logo a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .site-header__nav-link {
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .site-header__nav-link:hover {
    color: var(--color-accent);
  }

  .site-header__icons {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
  }

  .site-header__icon {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .site-header__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .site-header__icon--cart sup {
    position: absolute;
    top: -0.4rem;
    right: -0.6rem;
    min-width: 1rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background-color: var(--color-accent);
    color: var(--color-background);
    font-size: 0.625rem;
    line-height: 1rem;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .site-header {
      grid-template-columns: auto 1fr auto;
    }

    .site-header__nav {
      display: none;
    }

    .site-header__logo {
      justify-self: start;
      font-size: 1.375rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
