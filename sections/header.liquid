<header class="site-header">
  <button type="button" class="site-header__menu-toggle" data-dialog-open="mobile-menu">
    {{ 'icon-menu.svg' | inline_asset_content }}
    <span class="visually-hidden">{{ 'general.menu' | t }}</span>
  </button>

  <nav class="site-header__nav">
    {% for link in section.settings.menu.links %}
      {% if link.links.size > 0 %}
        <details class="mega-menu">
          <summary class="site-header__nav-link">
            {{ link.title }}
            {{ 'icon-chevron.svg' | inline_asset_content }}
          </summary>
          <div class="mega-menu__panel">
            {% for child in link.links %}
              {% if child.links.size > 0 %}
                <div class="mega-menu__column">
                  <p class="mega-menu__column-title">{{ child.title | link_to: child.url }}</p>
                  <ul class="mega-menu__column-list">
                    {% for grandchild in child.links %}
                      <li>{{ grandchild.title | link_to: grandchild.url }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% else %}
                <div class="mega-menu__column mega-menu__column--single">
                  {{ child.title | link_to: child.url }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </details>
      {% else %}
        {{ link.title | link_to: link.url, class: 'site-header__nav-link' }}
      {% endif %}
    {% endfor %}
  </nav>

  <h1 class="site-header__logo">
    {{ shop.name | link_to: routes.root_url }}
  </h1>

  <div class="site-header__icons">
    <a href="{{ routes.search_url }}" class="site-header__icon" aria-label="{{ 'search.title' | t }}">
      {{ 'icon-search.svg' | inline_asset_content }}
    </a>

    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}" class="site-header__icon">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <button type="button" class="site-header__icon site-header__icon--cart" data-dialog-open="cart-drawer">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}
      {{ 'icon-cart.svg' | inline_asset_content }}
      <span class="visually-hidden">{{ 'cart.title' | t }}</span>
    </button>
  </div>
</header>

<vetra-dialog id="mobile-menu">
  <dialog class="mobile-menu">
    <div class="mobile-menu__header">
      <p class="mobile-menu__title">{{ 'general.menu' | t }}</p>
      <button type="button" class="mobile-menu__close" data-dialog-close>
        {{ 'icon-close.svg' | inline_asset_content }}
        <span class="visually-hidden">{{ 'general.close' | t }}</span>
      </button>
    </div>

    <nav class="mobile-menu__nav">
      {% for link in section.settings.menu.links %}
        {% if link.links.size > 0 %}
          <details class="mobile-menu__group">
            <summary>
              {{ link.title }}
              {{ 'icon-chevron.svg' | inline_asset_content }}
            </summary>
            <ul class="mobile-menu__sublist">
              {% for child in link.links %}
                <li>{{ child.title | link_to: child.url }}</li>
                {% for grandchild in child.links %}
                  <li class="mobile-menu__subitem--nested">{{ grandchild.title | link_to: grandchild.url }}</li>
                {% endfor %}
              {% endfor %}
            </ul>
          </details>
        {% else %}
          {{ link.title | link_to: link.url }}
        {% endif %}
      {% endfor %}
    </nav>
  </dialog>
</vetra-dialog>

{% stylesheet %}
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--page-margin);
    height: 6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__menu-toggle {
    display: none;
    align-items: center;
    background: none;
    border: 0;
    padding: 0;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .site-header__menu-toggle svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  .site-header__logo {
    justify-self: center;
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 1.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-header__logo a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .site-header__nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .site-header__nav-link::-webkit-details-marker {
    display: none;
  }

  .site-header__nav-link svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  .site-header__nav-link:hover {
    color: var(--color-accent);
  }

  /* Mega menu */
  .mega-menu {
    position: relative;
  }

  .mega-menu__panel {
    display: none;
    position: absolute;
    top: calc(100% + 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    min-width: 32rem;
    padding: 1.75rem;
    gap: 2rem;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 8%);
  }

  .mega-menu[open] .mega-menu__panel {
    display: flex;
  }

  .mega-menu__column {
    min-width: 10rem;
  }

  .mega-menu__column-title {
    margin: 0 0 0.75rem;
    font-weight: var(--font-primary--weight);
  }

  .mega-menu__column-title a,
  .mega-menu__column--single a {
    color: var(--color-foreground);
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
  }

  .mega-menu__column-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mega-menu__column-list a {
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.8125rem;
    opacity: 0.8;
  }

  .mega-menu__column-list a:hover,
  .mega-menu__column-title a:hover,
  .mega-menu__column--single a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .site-header__icons {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
  }

  .site-header__icon {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--color-foreground);
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .site-header__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .site-header__icon--cart sup {
    position: absolute;
    top: -0.4rem;
    right: -0.6rem;
    min-width: 1rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background-color: var(--color-accent);
    color: var(--color-background);
    font-size: 0.625rem;
    line-height: 1rem;
    text-align: center;
  }

  /* Mobile menu dialog */
  .mobile-menu {
    width: 100%;
    max-width: 22rem;
    height: 100%;
    max-height: 100%;
    margin: 0 0 0 auto;
    padding: 1.5rem;
    border: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .mobile-menu::backdrop {
    background-color: rgb(0 0 0 / 40%);
  }

  .mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .mobile-menu__title {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
  }

  .mobile-menu__close {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground);
  }

  .mobile-menu__close svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-menu__nav > a,
  .mobile-menu__group summary {
    color: var(--color-foreground);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.9375rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }

  .mobile-menu__group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__group summary svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  .mobile-menu__sublist {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .mobile-menu__sublist a {
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.875rem;
    opacity: 0.85;
  }

  .mobile-menu__subitem--nested {
    padding-left: 0.75rem;
  }

  @media screen and (max-width: 749px) {
    .site-header {
      grid-template-columns: auto 1fr auto;
    }

    .site-header__menu-toggle {
      display: inline-flex;
    }

    .site-header__nav {
      display: none;
    }

    .site-header__logo {
      justify-self: start;
      font-size: 1.375rem;
    }
  }

  @media screen and (min-width: 750px) {
    .mobile-menu-toggle-only {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
