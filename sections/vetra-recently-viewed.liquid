{% comment %}
  Shows the shopper's most recently viewed products, tracked in
  localStorage (see assets/vetra-recently-viewed.js). Renders nothing
  server-side since the list is per-browser.
{% endcomment %}

<div class="recently-viewed shopify-section" data-recently-viewed data-exclude="{{ product.handle }}" hidden>
  {% if section.settings.heading != blank %}
    <h2 class="recently-viewed__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="recently-viewed__grid" data-recently-viewed-grid></div>
</div>

<script src="{{ 'vetra-recently-viewed.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .recently-viewed {
    padding: 3rem 0;
  }

  .recently-viewed__heading {
    margin: 0 0 2rem;
    text-align: center;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.75rem;
  }

  .recently-viewed__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 1.5rem;
  }

  .recently-viewed-card {
    display: block;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .recently-viewed-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-bottom: 0.5rem;
  }

  .recently-viewed-card__title {
    font-size: 0.8125rem;
    margin: 0 0 0.25rem;
  }

  .recently-viewed-card__price {
    font-size: 0.8125rem;
    opacity: 0.75;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.recently_viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Recently viewed"
    }
  ],
  "presets": [
    {
      "name": "t:general.recently_viewed"
    }
  ]
}
{% endschema %}
