{% comment %}
  A real shipping estimator: queries Shopify's cart shipping_rates.json
  endpoint for the current cart, so the rates shown are the shop's
  actual configured rates, not a static placeholder.
{% endcomment %}

<div class="shipping-estimator shopify-section">
  {% if section.settings.heading != blank %}
    <h2 class="shipping-estimator__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <form class="shipping-estimator__form" data-shipping-estimator-form>
    <label>
      <span>{{ 'shipping_estimator.country' | t }}</span>
      <input type="text" name="country" maxlength="2" placeholder="US" required>
    </label>
    <label>
      <span>{{ 'shipping_estimator.zip' | t }}</span>
      <input type="text" name="zip" required>
    </label>
    <button type="submit">{{ 'shipping_estimator.estimate' | t }}</button>
  </form>

  <div class="shipping-estimator__results" data-shipping-estimator-results></div>
</div>

<script src="{{ 'vetra-shipping-estimator.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .shipping-estimator {
    padding: 2.5rem 0;
  }

  .shipping-estimator__heading {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-size: 1.375rem;
  }

  .shipping-estimator__form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
  }

  .shipping-estimator__form label {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .shipping-estimator__form input {
    padding: 0.625rem;
    border: 1px solid var(--color-border);
    width: 8rem;
  }

  .shipping-estimator__form button {
    padding: 0.75rem 1.5rem;
    background-color: var(--color-accent);
    color: var(--color-background);
    border: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.8125rem;
    cursor: pointer;
    height: fit-content;
  }

  .shipping-estimator__results {
    margin-top: 1.25rem;
  }

  .shipping-estimator__rate {
    display: flex;
    justify-content: space-between;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.shipping_estimator",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Estimate shipping"
    }
  ],
  "presets": [
    {
      "name": "t:general.shipping_estimator"
    }
  ]
}
{% endschema %}
